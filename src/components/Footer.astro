---
---
<footer id="contacto" class="page-footer" role="contentinfo">
    <div class="footer-container">
        <div class="footer-cta">
            <h4 class="footer-cta-title">
                ¿Listo para tu próximo evento?
            </h4>
            <a class="footer-phone" href="tel:+1234567890">
                <span class="material-symbols-outlined">call</span>
                +1 234 567 890
            </a>
        </div>

        <div class="footer-socials">
            <a
                class="social-link"
                href="#"
                aria-label="Social - brand"
            >
                <span class="material-symbols-outlined social-icon">brand_awareness</span>
            </a>
            <a
                class="social-link"
                href="#"
                aria-label="Instagram"
            >
                <span class="material-symbols-outlined social-icon">photo_camera</span>
            </a>
            <a
                class="social-link"
                href="mailto:info@example.com"
                aria-label="Email"
            >
                <span class="material-symbols-outlined social-icon">mail</span>
            </a>
        </div>

        <p class="footer-copy">
            © 2026 Mixology Pro Services. Todos los derechos reservados.
        </p>
    </div>
</footer>

<style>
    .page-footer {
        margin-top: 2.5rem;
        padding-inline: 1.5rem;
        padding-block: 2.5rem;
        border-top: 1px solid var(--color-card-bg);
        background-color: rgba(0, 0, 0, 0.2);
        text-align: center;
    }

    .footer-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        max-width: var(--max-width-2xl);
        margin-inline: auto;
    }

    .footer-cta {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .footer-cta-title {
        color: var(--color-white);
        font-weight: 700;
        font-size: 1.125rem;
    }

    .footer-phone {
        color: var(--color-primary);
        font-size: 1.25rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .footer-socials {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
    }

    .social-link {
        color: var(--color-muted-beige);
        transition: color 0.2s;
    }

    .social-link:hover {
        color: var(--color-primary);
    }

    .social-icon {
        font-size: 28px;
    }

    .footer-copy {
        color: rgba(203, 188, 144, 0.5);
        font-size: 0.75rem;
    }
</style>
