---
import { Image } from "astro:assets";

export interface Props {
    id: string;
    title: string;
    desc: string;
    image: any;
    alt?: string;
    showActions?: boolean;
    whatsappUrl?: string;
    slug?: string;
}

const {
    id,
    title,
    desc,
    image,
    alt = title,
    showActions = false,
    whatsappUrl = "https://wa.me/1234567890",
    slug,
} = Astro.props;
---

<article
    class="cocktail-card"
    aria-labelledby={`cocktail-${id}-title`}
    transition:name={`cocktail-card-${id}`}
>
    <a href={slug ? `/cocteles/${slug}` : "#"} class="cocktail-image-link">
        <div class="cocktail-image-container" transition:name={`cocktail-image-${id}`}>
            {image && (
                <Image 
                    src={image} 
                    alt={alt} 
                    class="cocktail-image-file"
                />
            )}
        </div>
    </a>
    
    <div class="cocktail-content" transition:animate="fade">
        <div class="cocktail-header">
            <h3 id={`cocktail-${id}-title`} class="cocktail-title">
                {slug ? <a href={`/cocteles/${slug}`}>{title}</a> : title}
            </h3>
            <span class="cocktail-id">{id}</span>
        </div>
        <p class="cocktail-desc">{desc}</p>

        {showActions && (
            <div class="cocktail-actions">
                <a
                    class="btn-primary-sm"
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Contactar por ${title}`}
                >
                    <span class="material-symbols-outlined btn-icon">chat</span>
                    Reservar
                </a>

                {slug && (
                    <a class="btn-outline-sm" href={`/cocteles/${slug}`}>
                        <span class="material-symbols-outlined btn-icon">info</span>
                        Ver receta
                    </a>
                )}
            </div>
        )}
    </div>
</article>

<style>
    .cocktail-card {
        position: relative;
        overflow: hidden;
        border-radius: var(--radius-xl);
        background-color: var(--color-card-bg);
        border: 1px solid var(--color-card-border);
        transition: transform 0.2s;
    }

    .cocktail-card:hover {
        transform: translateY(-4px);
    }

    .cocktail-image-link {
        display: block;
        overflow: hidden;
    }

    .cocktail-image-container {
        aspect-ratio: 16 / 9;
        width: 100%;
        overflow: hidden;
    }

    .cocktail-image-file {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .cocktail-card:hover .cocktail-image-file {
        transform: scale(1.05);
    }

    @media (min-width: 768px) {
        .cocktail-image-container {
            aspect-ratio: 4 / 3;
        }
    }

    .cocktail-content {
        padding: 1rem;
    }

    .cocktail-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.25rem;
    }

    .cocktail-title {
        color: var(--color-primary);
        font-size: 1.25rem;
        font-weight: 700;
    }

    .cocktail-title a {
        color: inherit;
        text-decoration: none;
    }

    .cocktail-title a:hover {
        text-decoration: underline;
    }

    .cocktail-id {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.75rem;
        font-family: monospace;
    }

    .cocktail-desc {
        color: var(--color-muted-beige);
        font-size: 0.875rem;
    }

    .cocktail-actions {
        margin-top: 1rem;
        display: flex;
        gap: 0.75rem;
    }

    .btn-primary-sm {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        border-radius: var(--radius-full);
        background-color: var(--color-primary);
        color: var(--color-background-dark);
        font-size: 0.875rem;
        font-weight: 600;
        box-shadow: var(--shadow-primary-soft);
        text-decoration: none;
    }

    .btn-outline-sm {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        border-radius: var(--radius-full);
        background-color: transparent;
        border: 1px solid var(--color-card-border);
        color: var(--color-muted-beige);
        font-size: 0.875rem;
        text-decoration: none;
        transition: color 0.2s;
        cursor: pointer;
    }

    .btn-outline-sm:hover {
        color: var(--color-primary);
    }

    .btn-icon {
        font-size: 20px;
    }
</style>
