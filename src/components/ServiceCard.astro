---
/**
 * ServiceCard.astro
 *
 * Reusable service card component used in the services grid.
 *
 * Props:
 *  - icon: string (Material Symbol name)
 *  - title: string
 *  - description: string
 *
 */
export interface Props {
  icon?: string;
  title?: string;
  description?: string;
}

const {
  icon = "celebration",
  title = "Servicio",
  description = "Descripción breve del servicio.",
} = Astro.props;

/**
 * Create a simple id from the title for accessibility (aria-labelledby).
 */
const id = String(title)
  .toLowerCase()
  .replace(/[^a-z0-9\s-]/g, "")
  .trim()
  .replace(/\s+/g, "-");
---

<article class="service-card" role="article" aria-labelledby={`service-${id}`} transition:name={`service-card-${id}`}>
  <div class="service-icon-container" aria-hidden="true" transition:name={`service-icon-${id}`}>
    <span class="material-symbols-outlined service-icon">{icon}</span>
  </div>

  <div class="service-content">
    <h3 id={`service-${id}`} class="service-title">
      {title}
    </h3>
    <p class="service-description">
      {description}
    </p>
  </div>
</article>

<style>
  .service-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-card-border);
    background-color: rgba(52, 45, 24, 0.5);
    padding: 1.25rem;
    transition: all 0.3s ease;
    cursor: default;
  }

  .service-card:hover {
    transform: translateY(-5px);
    background-color: rgba(var(--color-primary-rgb), 0.15);
    border-color: var(--color-primary);
    box-shadow: 0 10px 25px -5px rgba(var(--color-primary-rgb), 0.2);
  }

  .service-icon-container {
    background-color: rgba(var(--color-primary-rgb), 0.1);
    padding: 0.75rem;
    border-radius: var(--radius-lg);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .service-card:hover .service-icon-container {
    transform: scale(1.1) rotate(5deg);
  }

  .service-icon {
    color: var(--color-primary);
    font-size: 32px;
  }

  .service-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .service-title {
    color: var(--color-white);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.25;
    transition: color 0.3s ease;
  }

  .service-card:hover .service-title {
    color: var(--color-primary);
  }

  .service-description {
    color: var(--color-muted-beige);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.5;
  }
</style>
