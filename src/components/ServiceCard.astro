---
/**
 * ServiceCard.astro
 *
 * Reusable service card component used in the services grid.
 *
 * Props:
 *  - icon: string (Material Symbol name)
 *  - title: string
 *  - description: string
 *
 * This variant intentionally mirrors the original design's exact token usage
 * (colors and borders) to keep visual parity with the reference HTML.
 */
export interface Props {
    icon?: string;
    title?: string;
    description?: string;
}

export let icon: string = "celebration";
export let title: string = "Servicio";
export let description: string = "Descripción breve del servicio.";

/**
 * Create a simple id from the title for accessibility (aria-labelledby).
 */
const id = String(title)
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, "")
    .trim()
    .replace(/\s+/g, "-");
---

<article
    class="flex flex-row items-center gap-4 rounded-xl border border-[#685a31] bg-[#342d18]/50 p-5"
    role="article"
    aria-labelledby={`service-${id}`}
>
    <div class="bg-primary/10 p-3 rounded-lg flex-shrink-0" aria-hidden="true">
        <span class="material-symbols-outlined text-primary text-[32px]"
            >{icon}</span
        >
    </div>

    <div class="flex flex-col gap-1">
        <h3
            id={`service-${id}`}
            class="text-white text-lg font-bold leading-tight"
        >
            {title}
        </h3>
        <p class="text-[#cbbc90] text-sm font-normal leading-normal">
            {description}
        </p>
    </div>
</article>
