---
---
<section class="contact-form-card">
    <h2 class="info-card-title">Envíanos un mensaje</h2>
    <p class="info-card-desc">
        Cuéntanos fecha, número de invitados y tipo de servicio para obtener
        un presupuesto rápido.
    </p>

    <form id="contact-form" class="contact-form">
        <div class="form-row">
            <label class="form-field">
                <span class="field-label">Nombre</span>
                <input
                    required
                    name="name"
                    type="text"
                    placeholder="Tu nombre"
                    class="form-input"
                />
            </label>

            <label class="form-field">
                <span class="field-label">Teléfono</span>
                <input
                    required
                    name="phone"
                    type="tel"
                    placeholder="+34 600 000 000"
                    class="form-input"
                />
            </label>
        </div>

        <label class="form-field">
            <span class="field-label">Correo electrónico</span>
            <input
                required
                name="email"
                type="email"
                placeholder="tu@correo.com"
                class="form-input"
            />
        </label>

        <label class="form-field">
            <span class="field-label">Detalles del evento</span>
            <textarea
                required
                name="message"
                rows="6"
                placeholder="Fecha, número de invitados, ubicación, servicio solicitado..."
                class="form-textarea"></textarea>
        </label>

        <div class="form-actions">
            <button type="submit" class="btn-submit">
                <span class="material-symbols-outlined btn-icon">send</span>
                Enviar mensaje
            </button>

            <button id="clear-btn" type="button" class="btn-clear">
                Limpiar
            </button>
        </div>

        <p id="form-status" class="form-status" aria-live="polite"></p>
    </form>

    <script type="module">
        const form = document.getElementById("contact-form");
        const status = document.getElementById("form-status");
        const clearBtn = document.getElementById("clear-btn");

        if (form) {
            form.addEventListener("submit", (e) => {
                e.preventDefault();
                const fd = new FormData(form);
                const name = fd.get("name") || "";
                const phone = fd.get("phone") || "";
                const email = fd.get("email") || "";
                const message = fd.get("message") || "";

                const subject = encodeURIComponent(`Contacto web - ${name}`);
                const bodyLines = [
                    `Nombre: ${name}`,
                    `Teléfono: ${phone}`,
                    `Email: ${email}`,
                    "",
                    "Mensaje:",
                    message,
                ];
                const body = encodeURIComponent(bodyLines.join("\n"));

                const mailto = `mailto:info@example.com?subject=${subject}&body=${body}`;

                try {
                    window.location.href = mailto;
                    status.textContent =
                        "Se abrió tu cliente de correo. Si no, usa la dirección info@example.com para enviarnos el mensaje.";
                } catch (err) {
                    status.textContent =
                        "No se ha podido abrir el cliente de correo. Envíanos un email a info@example.com.";
                }
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener("click", () => {
                form.reset();
                status.textContent = "";
            });
        }
    </script>
</section>

<style>
    .contact-form-card {
        background-color: var(--color-card-bg);
        border: 1px solid var(--color-card-border);
        border-radius: var(--radius-xl);
        padding: 1.5rem;
    }

    .info-card-title {
        color: var(--color-white);
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }

    .info-card-desc {
        color: var(--color-muted-beige);
        margin-bottom: 1rem;
    }

    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .form-row {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1rem;
    }

    @media (min-width: 640px) {
        .form-row {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    .form-field {
        display: flex;
        flex-direction: column;
    }

    .field-label {
        color: var(--color-muted-beige);
        font-size: 0.875rem;
        margin-bottom: 0.25rem;
    }

    .form-input,
    .form-textarea {
        padding: 0.5rem 0.75rem;
        border-radius: var(--radius-default);
        background-color: rgba(34, 30, 16, 0.6);
        border: 1px solid #3b3420;
        color: var(--color-white);
        transition:
            border-color 0.2s,
            box-shadow 0.2s;
    }

    .form-input:focus,
    .form-textarea:focus {
        outline: none;
        border-color: var(--color-primary);
        box-shadow: 0 0 0 2px rgba(var(--color-primary-rgb), 0.2);
    }

    .form-textarea {
        resize: vertical;
    }

    .form-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-top: 0.5rem;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: var(--radius-full);
        background-color: var(--color-primary);
        color: var(--color-background-dark);
        font-weight: 700;
        box-shadow: var(--shadow-primary-soft);
        border: none;
        cursor: pointer;
    }

    .btn-clear {
        padding: 0.5rem 1rem;
        border-radius: var(--radius-default);
        background-color: transparent;
        border: 1px solid #3b3420;
        color: var(--color-muted-beige);
        cursor: pointer;
        transition: color 0.2s;
    }

    .btn-clear:hover {
        color: var(--color-primary);
    }

    .btn-icon {
        font-size: 20px;
    }

    .form-status {
        font-size: 0.875rem;
        color: var(--color-muted-beige);
        margin-top: 0.75rem;
    }
</style>
