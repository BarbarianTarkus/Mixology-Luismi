---
import { Image } from "astro:assets";

/**
 * Hero.astro
 *
 * Re-implementation of the hero section from the design.
 *
 * Props:
 *  - title: main heading
 *  - eyebrow: small uppercase label above title
 *  - description: supporting paragraph
 *  - ctaText: call-to-action text
 *  - ctaHref: call-to-action link (default: WhatsApp link placeholder)
 *  - imageUrl: path to hero image (now supports Astro assets)
 *
 */
export interface Props {
  title?: string;
  eyebrow?: string;
  description?: string;
  ctaText?: string;
  ctaHref?: string;
  imageUrl?: any;
}

const {
  title = "Coctelería Exclusiva en tu Evento",
  eyebrow = "Servicio Premium a Domicilio",
  description = "Elevamos la experiencia de tus celebraciones con mixología de autor y barras móviles de lujo.",
  ctaText = "Contactar por WhatsApp",
  ctaHref = "https://wa.me/1234567890",
  imageUrl,
} = Astro.props;
---

<section class="hero-section">
  <div class="hero-content">
    <!-- Text Column -->
    <div class="hero-text" transition:animate="slide">
      <span class="hero-eyebrow">
        {eyebrow}
      </span>

      <h1 class="hero-title">
        {title}
      </h1>

      <p class="hero-description">
        {description}
      </p>

      <div class="hero-cta-container">
        <a
          class="hero-cta"
          href={ctaHref}
          rel="noopener noreferrer"
          target="_blank"
          aria-label={ctaText}
        >
          <span class="material-symbols-outlined cta-icon">chat</span>
          <span class="cta-text">{ctaText}</span>
        </a>
      </div>
    </div>

    <!-- Image Column for md+ -->
    <div
      id="hero-image"
      class="hero-image-col"
      transition:name="hero-image"
    >
      {imageUrl && (
        <Image 
          src={imageUrl} 
          alt={title} 
          class="hero-image-file"
        />
      )}
    </div>
  </div>
</section>

<style>
  .hero-section {
    container-type: inline-size;
  }

  .hero-content {
    display: flex;
    min-height: 520px;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .hero-content {
      flex-direction: row;
      align-items: stretch;
      text-align: left;
    }
  }

  .hero-text {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .hero-text {
      width: 50%;
    }
  }

  .hero-eyebrow {
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .hero-title {
    color: var(--color-white);
    font-size: 2.25rem;
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.033em;
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 3rem;
    }
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.75rem;
    }
  }

  .hero-description {
    color: var(--color-muted-beige);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.625;
    max-width: 24rem;
    margin-inline: auto;
  }

  @media (min-width: 768px) {
    .hero-description {
      font-size: 1.125rem;
      margin-inline: 0;
    }
  }

  .hero-cta-container {
    margin-top: 1rem;
  }

  .hero-cta {
    display: inline-flex;
    margin-top: 1rem;
    min-width: 220px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--radius-full);
    height: 3rem;
    padding-inline: 1.5rem;
    background-color: var(--color-primary);
    color: var(--color-background-dark);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.015em;
    box-shadow: 0 10px 15px -3px rgba(var(--color-primary-rgb), 0.2);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .hero-cta:active {
    transform: scale(0.98);
  }

  .cta-icon {
    margin-right: 0.5rem;
  }

  .cta-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero-image-col {
    display: block;
    width: 100%;
    height: 300px;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    margin-top: 1rem;
  }

  .hero-image-file {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.6);
  }

  .hero-image-col::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(0, 0, 0, 0) 0%, rgba(34, 30, 16, 0.95) 100%);
  }

  @media (min-width: 768px) {
    .hero-image-col {
      width: 50%;
      height: auto;
      min-height: 520px;
      border-radius: 10px 10px 0px 0px;
      margin-top: 0;
    }
  }
</style>
