---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ServiceCard from "../components/ServiceCard.astro";

export const prerender = true;

const pageTitle = "Luismi Mixology";
const pageDescription =
    "Servicio de coctelería a domicilio con mixología de autor, barras móviles premium y masterclasses.";

/**
 * Local images used by the page. Make sure these exist under /public/images/
 * - hero-large.jpg
 * - cocktail-1.jpg
 * - cocktail-2.jpg
 * - cocktail-3.jpg
 */
const heroImage = "/images/hero-large.jpg";
const cocktails = [
    {
        id: "01",
        title: "Old Fashioned Gold",
        desc: "Bourbon premium, amargo de angostura, terrón de azúcar y piel de naranja.",
        image: "/images/cocktail-1.jpg",
    },
    {
        id: "02",
        title: "Signature Mojito",
        desc: "Ron añejo, hierbabuena fresca, lima infusionada y un toque secreto del bartender.",
        image: "/images/cocktail-2.jpg",
    },
    {
        id: "03",
        title: "Espresso Velvet",
        desc: "Vodka premium, licor de café artesanal y un shot de espresso recién tostado.",
        image: "/images/cocktail-3.jpg",
    },
];
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    image={heroImage}
    url="https://example.com"
>
    <Header title={pageTitle} nav={[{ href: '#servicios', label: 'Servicios' }, { href: '#cocteles', label: 'Cócteles' }, { href: '#contacto', label: 'Contacto' }]} />

    <main class="main-content" role="main">
        <!-- Hero -->
        <Hero
            title="Coctelería Exclusiva en tu Evento"
            eyebrow="Servicio Premium a Domicilio"
            description="Elevamos la experiencia de tus celebraciones con mixología de autor y barras móviles de lujo."
            ctaText="Contactar por WhatsApp"
            ctaHref="https://wa.me/1234567890"
            imageUrl={heroImage}
        />

        <!-- Services header -->
        <section class="section-header" aria-labelledby="services-heading">
            <h2 id="services-heading" class="section-title">
                Nuestros Servicios
            </h2>
            <div class="title-underline"></div>
        </section>

        <!-- Services grid -->
        <section
            id="servicios"
            class="services-grid"
            aria-label="Servicios"
        >
            <ServiceCard
                icon="celebration"
                title="Fiestas Privadas"
                description="Barras móviles y atención personalizada para grupos selectos."
            />
            <ServiceCard
                icon="favorite"
                title="Bodas"
                description="Servicio de coctelería premium diseñado para tu gran día."
            />
            <ServiceCard
                icon="school"
                title="Masterclasses"
                description="Aprende a preparar los mejores cócteles con nuestros expertos."
            />
        </section>

        <!-- Cocktails header -->
        <section class="section-header" aria-labelledby="cocktails-heading">
            <h2 id="cocktails-heading" class="section-title">
                Top 3 Cócteles
            </h2>
            <div class="title-underline"></div>
        </section>

        <!-- Cocktails grid -->
        <section
            id="cocteles"
            class="cocktails-grid"
            aria-label="Top cocktails"
        >
            {
                cocktails.map((c) => (
                    <article class="cocktail-card" key={c.id}>
                        <div
                            class="cocktail-image"
                            role="img"
                            aria-label={c.title}
                            style={`background-image: url('${c.image}');`}
                        />
                        <!-- Hidden, accessible image fallback for non-CSS  assistive tech -->
                        <img src={c.image} alt={c.title} class="sr-only" />
                        <div class="cocktail-info">
                            <div class="cocktail-header">
                                <h3 class="cocktail-title">
                                    {c.title}
                                </h3>
                                <span class="cocktail-id">
                                    {c.id}
                                </span>
                            </div>
                            <p class="cocktail-desc">{c.desc}</p>
                        </div>
                    </article>
                ))
            }
        </section>

        <!-- Contact / Footer -->
        <footer id="contacto" class="page-footer" role="contentinfo">
            <div class="footer-container">
                <div class="footer-cta">
                    <h4 class="footer-cta-title">
                        ¿Listo para tu próximo evento?
                    </h4>
                    <a class="footer-phone" href="tel:+1234567890">
                        <span class="material-symbols-outlined">call</span>
                        +1 234 567 890
                    </a>
                </div>

                <div class="footer-socials">
                    <a
                        class="social-link"
                        href="#"
                        aria-label="Social - brand"
                    >
                        <span class="material-symbols-outlined social-icon">brand_awareness</span>
                    </a>
                    <a
                        class="social-link"
                        href="#"
                        aria-label="Instagram"
                    >
                        <span class="material-symbols-outlined social-icon">photo_camera</span>
                    </a>
                    <a
                        class="social-link"
                        href="mailto:info@example.com"
                        aria-label="Email"
                    >
                        <span class="material-symbols-outlined social-icon">mail</span>
                    </a>
                </div>

                <p class="footer-copy">
                    © 2024 Mixology Pro Services. Todos los derechos reservados.
                </p>
            </div>
        </footer>
    </main>

    <!-- Floating Action Button for Mobile -->
    <div class="fab-container">
        <a
            class="fab"
            href="https://wa.me/1234567890"
            aria-label="Contactar por WhatsApp"
            rel="noopener noreferrer"
            target="_blank"
        >
            <span class="material-symbols-outlined fab-icon">chat</span>
        </a>
    </div>
</BaseLayout>

<style>
    .main-content {
        max-width: var(--max-width-6xl);
        padding-inline: 1rem;
        margin-inline: auto;
        padding-bottom: 6rem;
    }

    .section-header {
        padding-inline: 1rem;
        padding-top: 2.5rem;
        padding-bottom: 0.5rem;
    }

    .section-title {
        color: var(--color-white);
        font-size: 24px;
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: -0.015em;
    }

    .title-underline {
        height: 4px;
        width: 3rem;
        background-color: var(--color-primary);
        margin-top: 0.5rem;
        border-radius: var(--radius-full);
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1rem;
        padding: 1rem;
    }

    @media (min-width: 640px) {
        .services-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 768px) {
        .services-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    .cocktails-grid {
        padding: 1rem;
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1.5rem;
    }

    @media (min-width: 768px) {
        .cocktails-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    .cocktail-card {
        position: relative;
        overflow: hidden;
        border-radius: var(--radius-xl);
        background-color: var(--color-card-bg);
        border: 1px solid var(--color-card-border);
        transition: transform 0.2s;
    }

    .cocktail-card:hover {
        transform: translateY(-4px);
    }

    .cocktail-image {
        aspect-ratio: 16 / 9;
        width: 100%;
        background-size: cover;
        background-position: center;
    }

    @media (min-width: 768px) {
        .cocktail-image {
            aspect-ratio: 4 / 3;
        }
    }

    .cocktail-info {
        padding: 1rem;
    }

    .cocktail-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.25rem;
    }

    .cocktail-title {
        color: var(--color-primary);
        font-size: 1.25rem;
        font-weight: 700;
    }

    .cocktail-id {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.75rem;
        font-family: monospace;
    }

    .cocktail-desc {
        color: var(--color-muted-beige);
        font-size: 0.875rem;
    }

    .page-footer {
        margin-top: 2.5rem;
        padding-inline: 1.5rem;
        padding-block: 2.5rem;
        border-top: 1px solid var(--color-card-bg);
        background-color: rgba(0, 0, 0, 0.2);
        text-align: center;
    }

    .footer-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        max-width: var(--max-width-2xl);
        margin-inline: auto;
    }

    .footer-cta {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .footer-cta-title {
        color: var(--color-white);
        font-weight: 700;
        font-size: 1.125rem;
    }

    .footer-phone {
        color: var(--color-primary);
        font-size: 1.25rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .footer-socials {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
    }

    .social-link {
        color: var(--color-muted-beige);
        transition: color 0.2s;
    }

    .social-link:hover {
        color: var(--color-primary);
    }

    .social-icon {
        font-size: 28px;
    }

    .footer-copy {
        color: rgba(203, 188, 144, 0.5);
        font-size: 0.75rem;
    }

    .fab-container {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 50;
    }

    @media (min-width: 768px) {
        .fab-container {
            display: none;
        }
    }

    .fab {
        background-color: var(--color-primary);
        color: var(--color-background-dark);
        width: 3.5rem;
        height: 3.5rem;
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 25px 50px -12px rgba(var(--color-primary-rgb), 0.4);
        transition: transform 0.2s;
    }

    .fab:active {
        transform: scale(0.95);
    }

    .fab-icon {
        font-size: 32px;
    }
</style>
