---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CocktailCard from "../components/CocktailCard.astro";
import Footer from "../components/Footer.astro";

export const prerender = true;

const pageTitle = "Luismi Mixology";
const pageDescription =
    "Servicio de coctelería a domicilio con mixología de autor, barras móviles premium y masterclasses.";

/**
 * Local images used by the page. Make sure these exist under /public/images/
 * - hero-large.jpg
 * - cocktail-1.jpg
 * - cocktail-2.jpg
 * - cocktail-3.jpg
 */
const heroImage = "/images/hero-large.jpg";
const cocktails = [
    {
        id: "01",
        title: "Old Fashioned Gold",
        desc: "Bourbon premium, amargo de angostura, terrón de azúcar y piel de naranja.",
        image: "/images/cocktail-1.jpg",
    },
    {
        id: "02",
        title: "Signature Mojito",
        desc: "Ron añejo, hierbabuena fresca, lima infusionada y un toque secreto del bartender.",
        image: "/images/cocktail-2.jpg",
    },
    {
        id: "03",
        title: "Espresso Velvet",
        desc: "Vodka premium, licor de café artesanal y un shot de espresso recién tostado.",
        image: "/images/cocktail-3.jpg",
    },
];
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    image={heroImage}
    url="https://example.com"
>
    <Header />
    <main class="main-content" role="main">
        <!-- Hero -->
        <Hero
            title="Coctelería Exclusiva en tu Evento"
            eyebrow="Servicio Premium a Domicilio"
            description="Elevamos la experiencia de tus celebraciones con mixología de autor y barras móviles de lujo."
            ctaText="Contactar por WhatsApp"
            ctaHref="https://wa.me/1234567890"
            imageUrl={heroImage}
        />

        <!-- Services header -->
        <section class="section-header" aria-labelledby="services-heading">
            <h2 id="services-heading" class="section-title">
                Nuestros Servicios
            </h2>
            <div class="title-underline"></div>
        </section>

        <!-- Services grid -->
        <section
            id="servicios"
            class="services-grid"
            aria-label="Servicios"
        >
            <ServiceCard
                icon="celebration"
                title="Fiestas Privadas"
                description="Barras móviles y atención personalizada para grupos selectos."
            />
            <ServiceCard
                icon="favorite"
                title="Bodas"
                description="Servicio de coctelería premium diseñado para tu gran día."
            />
            <ServiceCard
                icon="school"
                title="Masterclasses"
                description="Aprende a preparar los mejores cócteles con nuestros expertos."
            />
        </section>

        <!-- Cocktails header -->
        <section class="section-header" aria-labelledby="cocktails-heading">
            <h2 id="cocktails-heading" class="section-title">
                Top 3 Cócteles
            </h2>
            <div class="title-underline"></div>
        </section>

        <!-- Cocktails grid -->
        <section
            id="cocteles"
            class="cocktails-grid"
            aria-label="Top cocktails"
        >
            {
                cocktails.map((c) => (
                    <CocktailCard {...c} />
                ))
            }
        </section>

        <!-- Contact / Footer -->
        <Footer />
    </main>

    <!-- Floating Action Button for Mobile -->
    <div class="fab-container">
        <a
            class="fab"
            href="https://wa.me/1234567890"
            aria-label="Contactar por WhatsApp"
            rel="noopener noreferrer"
            target="_blank"
        >
            <span class="material-symbols-outlined fab-icon">chat</span>
        </a>
    </div>
</BaseLayout>

<style>
    .main-content {
        max-width: var(--max-width-6xl);
        padding-inline: 1rem;
        margin-inline: auto;
        padding-bottom: 6rem;
    }

    .section-header {
        padding-inline: 1rem;
        padding-top: 2.5rem;
        padding-bottom: 0.5rem;
    }

    .section-title {
        color: var(--color-white);
        font-size: 24px;
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: -0.015em;
    }

    .title-underline {
        height: 4px;
        width: 3rem;
        background-color: var(--color-primary);
        margin-top: 0.5rem;
        border-radius: var(--radius-full);
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1rem;
        padding: 1rem;
    }

    @media (min-width: 640px) {
        .services-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 768px) {
        .services-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    .cocktails-grid {
        padding: 1rem;
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1.5rem;
    }

    @media (min-width: 768px) {
        .cocktails-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    .fab-container {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 50;
    }

    @media (min-width: 768px) {
        .fab-container {
            display: none;
        }
    }

    .fab {
        background-color: var(--color-primary);
        color: var(--color-background-dark);
        width: 3.5rem;
        height: 3.5rem;
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 25px 50px -12px rgba(var(--color-primary-rgb), 0.4);
        transition: transform 0.2s;
    }

    .fab:active {
        transform: scale(0.95);
    }

    .fab-icon {
        font-size: 32px;
    }
</style>
