---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import CocktailCard from "../components/CocktailCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ContactFAB from "../components/ContactFAB.astro";
import Footer from "../components/Footer.astro";

export const prerender = true;

const pageTitle = "Luismi Mixology";
const pageDescription =
    "Servicio de coctelería a domicilio con mixología de autor, barras móviles premium y masterclasses.";

/**
 * Local images used by the page. Make sure these exist under /public/images/
 * - hero-large.jpg
 * - cocktail-1.jpg
 * - cocktail-2.jpg
 * - cocktail-3.jpg
 */
const heroImage = "/images/hero-large.jpg";
const cocktails = [
    {
        id: "01",
        title: "Old Fashioned Gold",
        desc: "Bourbon premium, amargo de angostura, terrón de azúcar y piel de naranja.",
        image: "/images/cocktail-1.jpg",
    },
    {
        id: "02",
        title: "Signature Mojito",
        desc: "Ron añejo, hierbabuena fresca, lima infusionada y un toque secreto del bartender.",
        image: "/images/cocktail-2.jpg",
    },
    {
        id: "03",
        title: "Espresso Velvet",
        desc: "Vodka premium, licor de café artesanal y un shot de espresso recién tostado.",
        image: "/images/cocktail-3.jpg",
    },
];
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    image={heroImage}
    url="https://example.com"
>
    <Header />
    <main class="main-content" role="main">
        <!-- Hero -->
        <Hero
            title="Coctelería Exclusiva en tu Evento"
            eyebrow="Servicio Premium a Domicilio"
            description="Elevamos la experiencia de tus celebraciones con mixología de autor y barras móviles de lujo."
            ctaText="Contactar por WhatsApp"
            ctaHref="https://wa.me/1234567890"
            imageUrl={heroImage}
        />

        <!-- Services header -->
        <SectionHeader id="services-heading" title="Nuestros Servicios" />

        <!-- Services grid -->
        <section id="servicios" aria-label="Servicios">
            <Services />
        </section>

        <!-- Cocktails header -->
        <SectionHeader id="cocktails-heading" title="Top 3 Cócteles" />

        <!-- Cocktails grid -->
        <section
            id="cocteles"
            class="cocktails-grid"
            aria-label="Top cocktails"
        >
            {
                cocktails.map((c) => (
                    <CocktailCard {...c} />
                ))
            }
        </section>

        <!-- Contact / Footer -->
        <Footer />
    </main>

    <ContactFAB />
</BaseLayout>

<style>
    .main-content {
        max-width: var(--max-width-6xl);
        padding-inline: 1rem;
        margin-inline: auto;
        padding-bottom: 6rem;
    }

    .cocktails-grid {
        padding: 1rem;
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1.5rem;
    }

    @media (min-width: 768px) {
        .cocktails-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>
