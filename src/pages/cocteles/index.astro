---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import CocktailCard from "../../components/CocktailCard.astro";
import ContactFAB from "../../components/ContactFAB.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, getEntry } from "astro:content";

export const prerender = true;

const title = "Luismi Mixology";
const description =
  "Descubre nuestros cócteles estrella: recetas de autor para eventos y celebraciones. Old Fashioned, Mojito y Espresso Martini, entre otros.";
const pageUrl = "/";

const cocktailsEntries = await getCollection("cocktails");
const cocktails = cocktailsEntries
  .sort((a, b) => a.slug.localeCompare(b.slug))
  .map(c => ({
    title: c.data.title,
    desc: c.data.desc,
    image: c.data.image || "",
    alt: c.data.alt,
    slug: c.slug,
  }));

const homeEntry = await getEntry("home", "index");
const contactEntry = await getEntry("contact", "index");

if (!homeEntry || !contactEntry) {
    throw new Error("Missing home or contact content");
}

const pageImage = homeEntry.data.heroImage;
---

<BaseLayout
  title={title}
  description={description}
  url={pageUrl}
  image={pageImage || ""}
>
  <Header />

  <main class="page-container" role="main">
    <!-- Page intro -->
    <section class="intro-section">
      <h1 class="intro-title">Top Cócteles</h1>
      <p class="intro-desc">
        Nuestra selección de cócteles de autor, pensada para eventos y
        celebraciones. Cada receta puede adaptarse a tus gustos y a las
        necesidades de tu evento.
      </p>
    </section>

    <!-- Cocktails grid -->
    <section
      id="cocteles"
      class="cocktails-grid"
      aria-label="Listado de cócteles"
    >
      {
        cocktails.map((c) => (
          <CocktailCard {...c} showActions={true} whatsappUrl={contactEntry.data.whatsappUrl} />
        ))
      }
    </section>

    <!-- Call to action -->
    <section class="cta-section">
      <div class="cta-box">
        <h2 class="cta-title">¿Quieres estos cócteles en tu evento?</h2>
        <p class="cta-desc">
          Contacta con nosotros para una propuesta personalizada y presupuesto
          en 24 horas.
        </p>
        <a
          class="btn-primary-lg"
          href={contactEntry.data.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Contactar por WhatsApp"
        >
          <span class="material-symbols-outlined btn-icon">chat</span>
          Contactar por WhatsApp
        </a>
      </div>
    </section>

    <Footer />
  </main>

  <ContactFAB />
</BaseLayout>

<style>
  .page-container {
    max-width: var(--max-width-6xl);
    margin-inline: auto;
    padding-inline: 1rem;
    padding-bottom: 6rem;
  }

  .intro-section {
    padding-top: 2.5rem;
    padding-bottom: 2rem;
    text-align: center;
  }

  .intro-title {
    color: var(--color-white);
    font-size: 2.25rem;
    font-weight: 800;
  }

  @media (min-width: 768px) {
    .intro-title {
      font-size: 3rem;
    }
  }

  .intro-desc {
    margin-top: 0.75rem;
    color: var(--color-muted-beige);
    max-width: var(--max-width-2xl);
    margin-inline: auto;
  }

  .cocktails-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.5rem;
    padding: 1rem;
  }

  @media (min-width: 640px) {
    .cocktails-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

    @media (min-width: 768px) {
      .cocktails-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .cta-section {
    margin-top: 3rem;
    text-align: center;
    padding-inline: 1rem;
  }

  .cta-box {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-xl);
    padding: 2rem;
  }

  .cta-title {
    color: var(--color-white);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .cta-desc {
    color: var(--color-muted-beige);
    max-width: 32rem;
  }

  .btn-primary-lg {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    color: var(--color-background-dark);
    font-weight: 700;
    box-shadow: var(--shadow-primary-soft);
  }
</style>
