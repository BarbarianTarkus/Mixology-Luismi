---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

export const prerender = true;

const title = "Top Cócteles — Mixology Pro";
const description = "Descubre nuestros cócteles estrella: recetas de autor para eventos y celebraciones. Old Fashioned, Mojito y Espresso Martini, entre otros.";
const pageUrl = "https://example.com/cocteles";
const pageImage = "/images/hero-large.jpg";

const cocktails = [
  {
    id: "01",
    title: "Old Fashioned Gold",
    desc: "Bourbon premium, amargo de angostura, terrón de azúcar y piel de naranja.",
    image: "/images/cocktail-1.jpg",
    alt: "Old Fashioned Gold closeup in a glass with orange peel"
  },
  {
    id: "02",
    title: "Signature Mojito",
    desc: "Ron añejo, hierbabuena fresca, lima infusionada y un toque secreto del bartender.",
    image: "/images/cocktail-2.jpg",
    alt: "Signature Mojito served with mint leaves and lime"
  },
  {
    id: "03",
    title: "Espresso Velvet",
    desc: "Vodka premium, licor de café artesanal y un shot de espresso recién tostado.",
    image: "/images/cocktail-3.jpg",
    alt: "Espresso Velvet in a coupe glass with coffee crema"
  },
  // Additional examples to expand the page for SEO value
  {
    id: "04",
    title: "Citrus Fizz",
    desc: "Gin infusionado con cítricos, clara de huevo y soda para un final efervescente.",
    image: "/images/cocktail-1.jpg",
    alt: "Citrus Fizz with foam and orange zest"
  },
  {
    id: "05",
    title: "Smoky Negroni",
    desc: "Versión ahumada del clásico Negroni con bitter artesanal y vermut envejecido.",
    image: "/images/cocktail-2.jpg",
    alt: "Smoky Negroni with a large ice cube and orange twist"
  },
];
---

<BaseLayout title={title} description={description} url={pageUrl} image={pageImage}>
  <Header />

  <main class="max-w-6xl mx-auto px-4 pb-24" role="main">
    <!-- Page intro -->
    <section class="pt-10 pb-8 text-center">
      <h1 class="text-white text-4xl md:text-5xl font-extrabold">Top Cócteles</h1>
      <p class="mt-3 text-muted-beige max-w-2xl mx-auto">
        Nuestra selección de cócteles de autor, pensada para eventos y celebraciones. Cada receta puede adaptarse a tus gustos y a las necesidades de tu evento.
      </p>
    </section>

    <!-- Cocktails grid -->
    <section id="cocteles" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 p-4" aria-label="Listado de cócteles">
      {cocktails.map((c) => (
        <article class="group relative overflow-hidden rounded-xl bg-card-bg border border-card-border" key={c.id} aria-labelledby={`cocktail-${c.id}-title`}>
          <div
            class="aspect-[16/9] md:aspect-[4/3] w-full bg-cover bg-center"
            role="img"
            aria-label={c.alt}
            style={`background-image: url('${c.image}');`}
          />
          <div class="p-4">
            <div class="flex justify-between items-start mb-1">
              <h3 id={`cocktail-${c.id}-title`} class="text-primary text-xl font-bold">{c.title}</h3>
              <span class="text-white/50 text-xs font-mono">{c.id}</span>
            </div>
            <p class="text-muted-beige text-sm">{c.desc}</p>

            <div class="mt-4 flex gap-3">
              <a
                class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-primary text-background-dark text-sm font-semibold shadow-primary-soft"
                href="https://wa.me/1234567890"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Contactar por ${c.title}`}
              >
                <span class="material-symbols-outlined">chat</span>
                Reservar
              </a>

              <button
                class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-transparent border border-[#685a31] text-muted-beige text-sm hover:text-primary"
                type="button"
                on:click={() => { /* placeholder: progressive enhancement could open recipe modal */ }}
              >
                <span class="material-symbols-outlined">info</span>
                Ver receta
              </button>
            </div>
          </div>
        </article>
      ))}
    </section>

    <!-- Call to action -->
    <section class="mt-12 text-center px-4">
      <div class="inline-flex flex-col items-center gap-4 bg-card-bg border border-card-border rounded-xl p-8">
        <h2 class="text-white text-2xl font-bold">¿Quieres estos cócteles en tu evento?</h2>
        <p class="text-muted-beige max-w-xl">Contacta con nosotros para una propuesta personalizada y presupuesto en 24 horas.</p>
        <a
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-primary text-background-dark font-bold shadow-primary-soft"
          href="https://wa.me/1234567890"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Contactar por WhatsApp"
        >
          <span class="material-symbols-outlined">chat</span>
          Contactar por WhatsApp
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
