---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ServiceCard from '../../components/ServiceCard.astro';

export const prerender = true;

const title = "Servicios — Mixology Pro";
const description = "Servicios de coctelería a domicilio: barras móviles, bodas, masterclasses y soluciones corporativas con mixología de autor.";
const pageUrl = "https://example.com/servicios";
const pageImage = "/images/hero-large.jpg";

const services = [
  {
    icon: "celebration",
    title: "Fiestas Privadas",
    description: "Barras móviles y atención personalizada para grupos selectos. Montaje, servicio y desmontaje adaptado a tu evento."
  },
  {
    icon: "favorite",
    title: "Bodas",
    description: "Coctelería premium diseñada para tu gran día: cócteles a medida, barras temáticas y servicio discreto y profesional."
  },
  {
    icon: "school",
    title: "Masterclasses",
    description: "Sesiones prácticas y teóricas con nuestros bartenders: desde iniciación hasta técnicas avanzadas y creación de recetas."
  },
  {
    icon: "work",
    title: "Eventos Corporativos",
    description: "Soluciones de coctelería corporativa: showcooking, cócteles de marca y barras para ferias, lanzamientos y cenas de empresa."
  },
  {
    icon: "local_bar",
    title: "Alquiler de Barras",
    description: "Barras móviles de diseño, equipadas y con personal cualificado para integrarse con tu decoración y logística."
  },
  {
    icon: "support",
    title: "Consultoría & Diseño de Carta",
    description: "Asesoramiento en selección de bebidas, creación de cartas personalizadas y formación para tu equipo."
  }
];
---

<BaseLayout title={title} description={description} url={pageUrl} image={pageImage}>
  <Header />

  <main class="page-container" role="main">
    <!-- Page Hero -->
    <section class="intro-section">
      <h1 class="intro-title">Nuestros Servicios</h1>
      <p class="intro-desc">
        Ofrecemos soluciones completas de mixología para eventos privados, corporativos y formaciones. Elige el servicio que mejor se adapta a tu experiencia.
      </p>
      <div class="intro-actions">
        <a
          href="https://wa.me/1234567890"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary-lg"
          aria-label="Contactar por WhatsApp"
        >
          <span class="material-symbols-outlined btn-icon">chat</span>
          Contactar por WhatsApp
        </a>
      </div>
    </section>

    <!-- Services Grid -->
    <section id="servicios-list" aria-labelledby="servicios-heading" class="services-section">
      <h2 id="servicios-heading" class="sr-only">Listado de Servicios</h2>

      <div class="services-grid">
        {services.map((s) => (
          <ServiceCard icon={s.icon} title={s.title} description={s.description} />
        ))}
      </div>
    </section>

    <!-- Detail / Why choose us -->
    <section class="details-section">
      <div class="details-card">
        <div class="details-layout">
          <div class="details-main">
            <h3 class="details-title">Por qué elegir Mixology Pro</h3>
            <p class="details-desc">
              Combinamos ingredientes seleccionados, personal altamente formado y un enfoque de atención al detalle que asegura que cada bebida sea una experiencia.
              Ofrecemos coordinación logística, menús personalizados y servicio profesional acorde al tono de tu evento.
            </p>
            <ul class="details-list">
              <li>Material y equipamiento premium</li>
              <li>Menús personalizados y coctelería de autor</li>
              <li>Equipo profesional y presencia impecable</li>
              <li>Opciones sin alcohol y adaptaciones dietéticas</li>
            </ul>
          </div>

          <aside class="details-aside">
            <div class="aside-box">
              <h4 class="aside-title">Presupuesto rápido</h4>
              <p class="aside-desc">
                Dinos fecha, número de invitados y tipo de servicio y te devolvemos una propuesta en 24h.
              </p>
            </div>

            <a
              class="btn-primary-full"
              href="/contacto"
            >
              <span class="material-symbols-outlined btn-icon">call</span>
              Solicitar presupuesto
            </a>
          </aside>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .page-container {
    max-width: var(--max-width-6xl);
    margin-inline: auto;
    padding-inline: 1rem;
    padding-bottom: 6rem;
  }

  .intro-section {
    padding-top: 2.5rem;
    padding-bottom: 1.5rem;
    text-align: center;
  }

  .intro-title {
    color: var(--color-white);
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .intro-desc {
    margin-top: 0.75rem;
    color: var(--color-muted-beige);
    max-width: var(--max-width-2xl);
    margin-inline: auto;
  }

  .intro-actions {
    margin-top: 1.5rem;
    display: flex;
    justify-content: center;
  }

  .btn-primary-lg {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    color: var(--color-background-dark);
    font-weight: 700;
    box-shadow: var(--shadow-primary-soft);
  }

  .btn-icon {
    font-size: 20px;
  }

  .services-section {
    padding-inline: 1rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .details-section {
    padding-inline: 1rem;
    margin-top: 3rem;
  }

  .details-card {
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-xl);
    padding: 1.5rem;
  }

  .details-layout {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .details-layout {
      flex-direction: row;
    }
  }

  .details-main {
    width: 100%;
  }

  @media (min-width: 768px) {
    .details-main {
      width: 66.666667%;
    }
  }

  .details-title {
    color: var(--color-white);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .details-desc {
    margin-top: 0.75rem;
    color: var(--color-muted-beige);
  }

  .details-list {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--color-muted-beige);
    list-style: disc inside;
  }

  .details-aside {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .details-aside {
      width: 33.333333%;
    }
  }

  .aside-box {
    background-color: rgba(34, 30, 16, 0.6);
    padding: 1rem;
    border-radius: var(--radius-lg);
    width: 100%;
  }

  .aside-title {
    color: var(--color-primary);
    font-weight: 700;
  }

  .aside-desc {
    color: var(--color-muted-beige);
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }

  .btn-primary-full {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-default);
    background-color: var(--color-primary);
    color: var(--color-background-dark);
    font-weight: 600;
  }
</style>
