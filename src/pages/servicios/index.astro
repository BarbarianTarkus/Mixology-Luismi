---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Services from "../../components/Services.astro";
import WhyChooseUs from "../../components/WhyChooseUs.astro";
import ContactFAB from "../../components/ContactFAB.astro";
import Footer from "../../components/Footer.astro";

export const prerender = true;

const title = "Servicios — Mixology Pro";
const description =
  "Servicios de coctelería a domicilio: barras móviles, bodas, masterclasses y soluciones corporativas con mixología de autor.";
const pageUrl = "https://example.com/servicios";
const pageImage = "/images/hero-large.jpg";

const services = [
  {
    icon: "celebration",
    title: "Fiestas Privadas",
    description:
      "Barras móviles y atención personalizada para grupos selectos. Montaje, servicio y desmontaje adaptado a tu evento.",
  },
  {
    icon: "favorite",
    title: "Bodas",
    description:
      "Coctelería premium diseñada para tu gran día: cócteles a medida, barras temáticas y servicio discreto y profesional.",
  },
  {
    icon: "school",
    title: "Masterclasses",
    description:
      "Sesiones prácticas y teóricas con nuestros bartenders: desde iniciación hasta técnicas avanzadas y creación de recetas.",
  },
  {
    icon: "work",
    title: "Eventos Corporativos",
    description:
      "Soluciones de coctelería corporativa: showcooking, cócteles de marca y barras para ferias, lanzamientos y cenas de empresa.",
  },
  {
    icon: "local_bar",
    title: "Alquiler de Barras",
    description:
      "Barras móviles de diseño, equipadas y con personal cualificado para integrarse con tu decoración y logística.",
  },
  {
    icon: "support",
    title: "Consultoría & Diseño de Carta",
    description:
      "Asesoramiento en selección de bebidas, creación de cartas personalizadas y formación para tu equipo.",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  url={pageUrl}
  image={pageImage}
>
  <Header />

  <main class="page-container" role="main">
    <!-- Page Hero -->
    <section class="intro-section">
      <h1 class="intro-title">Nuestros Servicios</h1>
      <p class="intro-desc">
        Ofrecemos soluciones completas de mixología para eventos privados,
        corporativos y formaciones. Elige el servicio que mejor se adapta a tu
        experiencia.
      </p>
      <div class="intro-actions">
        <a
          href="https://wa.me/1234567890"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary-lg"
          aria-label="Contactar por WhatsApp"
        >
          <span class="material-symbols-outlined btn-icon">chat</span>
          Contactar por WhatsApp
        </a>
      </div>
    </section>

    <!-- Services Grid -->
    <section
      id="servicios-list"
      aria-labelledby="servicios-heading"
      class="services-section"
    >
      <h2 id="servicios-heading" class="sr-only">Listado de Servicios</h2>

      <Services services={services} />
    </section>

    <!-- Detail / Why choose us -->
    <WhyChooseUs />

    <Footer />
  </main>

  <ContactFAB />
</BaseLayout>

<style>
  .page-container {
    max-width: var(--max-width-6xl);
    margin-inline: auto;
    padding-inline: 1rem;
    padding-bottom: 6rem;
  }

  .intro-section {
    padding-top: 2.5rem;
    padding-bottom: 1.5rem;
    text-align: center;
  }

  .intro-title {
    color: var(--color-white);
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .intro-desc {
    margin-top: 0.75rem;
    color: var(--color-muted-beige);
    max-width: var(--max-width-2xl);
    margin-inline: auto;
  }

  .intro-actions {
    margin-top: 1.5rem;
    display: flex;
    justify-content: center;
  }

  .btn-primary-lg {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    background-color: var(--color-primary);
    color: var(--color-background-dark);
    font-weight: 700;
    box-shadow: var(--shadow-primary-soft);
  }

  .btn-icon {
    font-size: 20px;
  }

  .services-section {
    padding-inline: 1rem;
  }
</style>
