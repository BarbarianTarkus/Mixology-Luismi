---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Hero from '../../components/Hero.astro';

export const prerender = true;

const title = "Servicios — Mixology Pro";
const description = "Servicios de coctelería a domicilio: barras móviles, bodas, masterclasses y soluciones corporativas con mixología de autor.";
const pageUrl = "https://example.com/servicios";
const pageImage = "/images/hero-large.jpg";

const services = [
  {
    icon: "celebration",
    title: "Fiestas Privadas",
    description: "Barras móviles y atención personalizada para grupos selectos. Montaje, servicio y desmontaje adaptado a tu evento."
  },
  {
    icon: "favorite",
    title: "Bodas",
    description: "Coctelería premium diseñada para tu gran día: cócteles a medida, barras temáticas y servicio discreto y profesional."
  },
  {
    icon: "school",
    title: "Masterclasses",
    description: "Sesiones prácticas y teóricas con nuestros bartenders: desde iniciación hasta técnicas avanzadas y creación de recetas."
  },
  {
    icon: "work",
    title: "Eventos Corporativos",
    description: "Soluciones de coctelería corporativa: showcooking, cócteles de marca y barras para ferias, lanzamientos y cenas de empresa."
  },
  {
    icon: "local_bar",
    title: "Alquiler de Barras",
    description: "Barras móviles de diseño, equipadas y con personal cualificado para integrarse con tu decoración y logística."
  },
  {
    icon: "support",
    title: "Consultoría & Diseño de Carta",
    description: "Asesoramiento en selección de bebidas, creación de cartas personalizadas y formación para tu equipo."
  }
];
---

<BaseLayout title={title} description={description} url={pageUrl} image={pageImage}>
  <Header />

  <main class="max-w-6xl mx-auto px-4 pb-24" role="main">
    <!-- Page Hero -->
    <section class="pt-10 pb-6 text-center">
      <h1 class="text-white text-4xl font-extrabold tracking-tight">Nuestros Servicios</h1>
      <p class="mt-3 text-muted-beige max-w-2xl mx-auto">
        Ofrecemos soluciones completas de mixología para eventos privados, corporativos y formaciones. Elige el servicio que mejor se adapta a tu experiencia.
      </p>
      <div class="mt-6 flex justify-center">
        <a
          href="https://wa.me/1234567890"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-primary text-background-dark font-bold shadow-primary-soft"
          aria-label="Contactar por WhatsApp"
        >
          <span class="material-symbols-outlined">chat</span>
          Contactar por WhatsApp
        </a>
      </div>
    </section>

    <!-- Services Grid -->
    <section id="servicios-list" aria-labelledby="servicios-heading" class="px-4">
      <h2 id="servicios-heading" class="sr-only">Listado de Servicios</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((s) => (
          <ServiceCard icon={s.icon} title={s.title} description={s.description} />
        ))}
      </div>
    </section>

    <!-- Detail / Why choose us -->
    <section class="px-4 mt-12">
      <div class="bg-card-bg border border-card-border rounded-xl p-6">
        <div class="flex flex-col md:flex-row gap-6 items-start">
          <div class="md:w-2/3">
            <h3 class="text-white text-2xl font-bold">Por qué elegir Mixology Pro</h3>
            <p class="mt-3 text-muted-beige">
              Combinamos ingredientes seleccionados, personal altamente formado y un enfoque de atención al detalle que asegura que cada bebida sea una experiencia.
              Ofrecemos coordinación logística, menús personalizados y servicio profesional acorde al tono de tu evento.
            </p>
            <ul class="mt-4 space-y-2 text-muted-beige list-disc list-inside">
              <li>Material y equipamiento premium</li>
              <li>Menús personalizados y coctelería de autor</li>
              <li>Equipo profesional y presencia impecable</li>
              <li>Opciones sin alcohol y adaptaciones dietéticas</li>
            </ul>
          </div>

          <aside class="md:w-1/3 flex flex-col items-start gap-4">
            <div class="bg-background-dark/60 p-4 rounded-lg w-full">
              <h4 class="text-primary font-bold">Presupuesto rápido</h4>
              <p class="text-muted-beige text-sm mt-2">
                Dinos fecha, número de invitados y tipo de servicio y te devolvemos una propuesta en 24h.
              </p>
            </div>

            <a
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 rounded-md bg-primary text-background-dark font-semibold"
              href="/contacto"
            >
              <span class="material-symbols-outlined">call</span>
              Solicitar presupuesto
            </a>
          </aside>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
