---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import ContactInfo from "../../components/ContactInfo.astro";
import ContactForm from "../../components/ContactForm.astro";
import ContactFAB from "../../components/ContactFAB.astro";
import Footer from "../../components/Footer.astro";

export const prerender = true;

const title = "Contacto — Luismi Mixology";
const description =
  "Contacta con Luismi Mixology para reservas, presupuestos y consultas sobre nuestros servicios de coctelería a domicilio.";
const pageUrl = "https://example.com/contacto";
const pageImage = "/images/hero-large.jpg";
---

<BaseLayout
  title={title}
  description={description}
  url={pageUrl}
  image={pageImage}
>
  <Header />

  <main class="page-container" role="main">
    <section class="intro-section">
      <h1 class="intro-title">Contacto</h1>
      <p class="intro-desc">
        ¿Listo para planear tu evento? Rellena el formulario o utiliza uno de
        los métodos de contacto para recibir una propuesta personalizada.
      </p>
    </section>

    <div class="contact-grid">
      <ContactInfo />
      <ContactForm />
    </div>

    <Footer />
  </main>

  <ContactFAB />
</BaseLayout>

<style>
  .page-container {
    max-width: var(--max-width-4xl);
    margin-inline: auto;
    padding-inline: 1rem;
    padding-block: 4rem;
  }

  .intro-section {
    text-align: center;
    margin-bottom: 3rem;
  }

  .intro-title {
    color: var(--color-white);
    font-size: 2.25rem;
    font-weight: 800;
  }

  .intro-desc {
    margin-top: 0.75rem;
    color: var(--color-muted-beige);
    max-width: var(--max-width-2xl);
    margin-inline: auto;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
